{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beautiful Batches",
  "version": "0.3.0",
  "identifier": "com.ctrlcat.beautifulbatches",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Beautiful Batches",
        "width": 1440,
        "height": 920,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "name": "JPEG Image",
        "description": "JPEG image file",
        "mimeType": "image/jpeg",
        "role": "Editor"
      },
      {
        "ext": [
          "png"
        ],
        "name": "PNG Image",
        "description": "PNG image file",
        "mimeType": "image/png",
        "role": "Editor"
      },
      {
        "ext": [
          "webp"
        ],
        "name": "WebP Image",
        "description": "WebP image file",
        "mimeType": "image/webp",
        "role": "Editor"
      },
      {
        "ext": [
          "avif"
        ],
        "name": "AVIF Image",
        "description": "AVIF image file",
        "mimeType": "image/avif",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
